# Optional local client settings. Server runtime is generated by scripts/init-runtime.py.
AI_DASH_HOME=.
AI_DASH_DATA_DIR=./var
AI_DASH_GATEWAY_URL=http://127.0.0.1:18082
AI_DASH_X_GATEWAY_URL=http://127.0.0.1:18081
AI_DASH_RUNTIME=/var/code/ai-dash-runtime
AI_DASH_TELEGRAM_TOKEN_FILE=/absolute/private/path/telegram_token
AI_DASH_TELEGRAM_CHAT_ID_FILE=/absolute/private/path/telegram_chat_id
